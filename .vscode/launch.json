{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Launch Project",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/test.exe", // 可执行文件路径
            "args": [],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}", // 设置工作目录为项目根目录
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "miDebuggerPath": "C:/msys64/ucrt64/bin/gdb.exe", // GDB 路径
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ],
            "preLaunchTask": "Build Project", // 指定前置任务
        }
    ]
}
